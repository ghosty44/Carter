{
  "name": "04 — Intermarché Drive sync",
  "_comment": "Nécessite les credentials Intermarché API. Voir docs/intermarche_api.md pour la procédure d'enregistrement développeur.",
  "nodes": [
    {
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000001",
      "name": "Telegram Trigger — Drive",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 400],
      "webhookId": "telegram-drive-webhook",
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.callback_query?.data }}", "rightValue": "send_to_drive", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        }
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000002",
      "name": "IF — Callback send_to_drive",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [260, 400]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "={{ $env.NOTION_DB_HISTORIQUE }}",
          "mode": "id"
        },
        "filterType": "json",
        "filterJson": "={ \"property\": \"Statut\", \"select\": { \"equals\": \"Validé\" } }",
        "returnAll": false,
        "limit": 1,
        "sort": { "sortValue": [{ "key": "Date_début", "order": "descending" }] }
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000003",
      "name": "Notion — Get liste courses",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [520, 400],
      "credentials": { "notionApi": { "id": "NOTION_CREDENTIAL_ID", "name": "Notion API" } }
    },
    {
      "parameters": {
        "jsCode": "// Parse shopping list JSON and flatten to array of items\nconst hist = $input.first().json;\nconst listRaw = hist.properties?.Liste_courses_finale?.rich_text?.[0]?.plain_text || '{}';\nconst list = JSON.parse(listRaw);\n\nconst items = [];\nfor (const [cat, catItems] of Object.entries(list)) {\n  (catItems || []).forEach(item => {\n    items.push({ article: item.article, quantite: item.quantite, unite: item.unite, categorie: cat });\n  });\n}\n\nconst chatId = $input.first().json.properties?.Telegram_chat_id?.number\n  || process.env.TELEGRAM_CHAT_ID_PRINCIPAL;\n\nreturn [{ json: { items, chatId, total: items.length } }];"
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000004",
      "name": "Code — Parser liste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.intermarche.com/oauth/token",
        "sendBody": true,
        "bodyType": "form",
        "body": {
          "grant_type": "client_credentials",
          "client_id": "={{ $env.INTERMARCHE_CLIENT_ID }}",
          "client_secret": "={{ $env.INTERMARCHE_CLIENT_SECRET }}"
        },
        "options": {}
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000005",
      "name": "HTTP — Auth Intermarché",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 400]
    },
    {
      "parameters": {
        "jsCode": "// Loop over each item and add to Intermarché cart\n// This is a sequential loop since we need the access token\nconst accessToken = $input.first().json.access_token;\nconst items = $('Code — Parser liste').first().json.items;\nconst storeId = process.env.INTERMARCHE_STORE_ID;\nconst results = { added: [], notFound: [], errors: [] };\n\n// Note: In n8n, actual HTTP calls in a Code node require using $http (unavailable in sandboxed mode)\n// The real implementation uses a Split In Batches node + HTTP Request node per item\n// This node prepares the data for the loop\nreturn items.map(item => ({\n  json: { ...item, accessToken, storeId }\n}));"
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000006",
      "name": "Code — Préparer items pour loop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.intermarche.com/stores/{{ $json.storeId }}/catalog/search?q={{ encodeURIComponent($json.article) }}&limit=1",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.accessToken }}" }] },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000007",
      "name": "HTTP — Recherche produit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.intermarche.com/stores/{{ $('Code — Préparer items pour loop').item.json.storeId }}/carts/current/items",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Code — Préparer items pour loop').item.json.accessToken }}" }] },
        "sendBody": true,
        "bodyType": "json",
        "body": {
          "product_id": "={{ $json.items?.[0]?.id }}",
          "quantity": "={{ parseInt($('Code — Préparer items pour loop').item.json.quantite) || 1 }}"
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000008",
      "name": "HTTP — Ajouter au panier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 500]
    },
    {
      "parameters": {
        "jsCode": "// Collect all results and build Telegram summary\nconst allResults = $input.all();\nconst added = allResults.filter(r => r.json.statusCode === 200 || r.json.id);\nconst notFound = allResults.filter(r => !r.json.id);\n\nconst chatId = $('Code — Parser liste').first().json.chatId;\n\nlet msg = `✅ *${added.length} articles ajoutés au Drive*\\n`;\nif (notFound.length > 0) {\n  msg += `\\n⚠️ *${notFound.length} articles non trouvés* (à ajouter manuellement) :\\n`;\n  notFound.forEach(r => { msg += `• ${r.json.article}\\n`; });\n}\nmsg += `\\n👉 [Accéder au Drive Intermarché](https://drive.intermarche.com/mon-panier)`;\n\nreturn [{ json: { msg, chatId } }];"
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000009",
      "name": "Code — Résumé Drive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.msg }}",
        "additionalFields": { "parse_mode": "Markdown", "disable_web_page_preview": true }
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000010",
      "name": "Telegram — Résumé Drive",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2080, 400],
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    }
  ],
  "connections": {
    "Telegram Trigger — Drive":         { "main": [[{ "node": "IF — Callback send_to_drive",      "type": "main", "index": 0 }]] },
    "IF — Callback send_to_drive":      { "main": [[{ "node": "Notion — Get liste courses",        "type": "main", "index": 0 }], []] },
    "Notion — Get liste courses":       { "main": [[{ "node": "Code — Parser liste",               "type": "main", "index": 0 }]] },
    "Code — Parser liste":              { "main": [[{ "node": "HTTP — Auth Intermarché",            "type": "main", "index": 0 }]] },
    "HTTP — Auth Intermarché":          { "main": [[{ "node": "Code — Préparer items pour loop",   "type": "main", "index": 0 }]] },
    "Code — Préparer items pour loop":  { "main": [[{ "node": "HTTP — Recherche produit",          "type": "main", "index": 0 }]] },
    "HTTP — Recherche produit":         { "main": [[{ "node": "HTTP — Ajouter au panier",          "type": "main", "index": 0 }]] },
    "HTTP — Ajouter au panier":         { "main": [[{ "node": "Code — Résumé Drive",               "type": "main", "index": 0 }]] },
    "Code — Résumé Drive":              { "main": [[{ "node": "Telegram — Résumé Drive",           "type": "main", "index": 0 }]] }
  },
