{
  "name": "02 — Validation callbacks Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Telegram Trigger — Callbacks",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 400],
      "webhookId": "telegram-callback-webhook",
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    },
    {
      "parameters": {
        "jsCode": "// Extract callback data and metadata\nconst cb = $input.first().json;\nconst data = cb.callback_query?.data || '';\nconst callbackId = cb.callback_query?.id;\nconst chatId = cb.callback_query?.message?.chat?.id;\nconst messageId = cb.callback_query?.message?.message_id;\n\nlet action = 'unknown';\nlet jour = null;\nlet recipeId = null;\n\nif (data.startsWith('validate_day_')) {\n  action = 'validate_day';\n  const parts = data.replace('validate_day_', '').split('_');\n  jour = parts[0];\n  recipeId = parts.slice(1).join('_');\n} else if (data.startsWith('replace_day_')) {\n  action = 'replace_day';\n  jour = data.replace('replace_day_', '');\n} else if (data === 'validate_all') {\n  action = 'validate_all';\n} else if (data === 'send_to_drive') {\n  action = 'send_to_drive';\n} else if (data.startsWith('add_custom')) {\n  action = 'add_custom';\n}\n\nreturn [{ json: { action, jour, recipeId, callbackId, chatId, messageId, raw: data } }];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Code — Parser callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 400]
    },
    {
      "parameters": {
        "mode": "expression",
        "output": "={{ $json.action }}",
        "rules": {
          "rules": [
            { "value": "validate_day",  "renameOutput": true, "outputKey": "validate_day"  },
            { "value": "replace_day",   "renameOutput": true, "outputKey": "replace_day"   },
            { "value": "validate_all",  "renameOutput": true, "outputKey": "validate_all"  },
            { "value": "send_to_drive", "renameOutput": true, "outputKey": "send_to_drive" }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Switch — Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [520, 400]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "={{ $env.NOTION_DB_HISTORIQUE }}",
          "mode": "id"
        },
        "filterType": "json",
        "filterJson": "={ \"property\": \"Statut\", \"select\": { \"equals\": \"En attente\" } }",
        "returnAll": false,
        "limit": 1,
        "sort": { "sortValue": [{ "key": "Date_début", "order": "descending" }] },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Notion — Semaine en cours",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [780, 200],
      "credentials": { "notionApi": { "id": "NOTION_CREDENTIAL_ID", "name": "Notion API" } }
    },
    {
      "parameters": {
        "jsCode": "// Update the Validation_json field to mark this day as validated\nconst historique = $('Notion — Semaine en cours').first().json;\nconst validationRaw = historique.properties?.Validation_json?.rich_text?.[0]?.plain_text || '{}';\nconst validation = JSON.parse(validationRaw);\nconst cb = $('Code — Parser callback').first().json;\n\nif (cb.jour && validation[cb.jour]) {\n  validation[cb.jour].validé = true;\n}\n\nconst allValidated = Object.values(validation).every(v => v.validé);\n\nreturn [{\n  json: {\n    historiqueId: historique.id,\n    validation,\n    validationJson: JSON.stringify(validation),\n    allValidated,\n    chatId: cb.chatId,\n    messageId: cb.messageId,\n    callbackId: cb.callbackId\n  }\n}];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "Code — Mise à jour état validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 200]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": "={{ $json.historiqueId }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Validation_json", "type": "richText", "textContent": "={{ $json.validationJson }}" }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "Notion — Update validation",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1300, 200],
      "credentials": { "notionApi": { "id": "NOTION_CREDENTIAL_ID", "name": "Notion API" } }
    },
    {
      "parameters": {
        "operation": "answerQuery",
        "queryId": "={{ $('Code — Mise à jour état validation').first().json.callbackId }}",
        "text": "✅ Recette validée !",
        "additionalFields": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000007",
      "name": "Telegram — Answer callback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1560, 200],
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $('Code — Mise à jour état validation').first().json.allValidated }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000008",
      "name": "IF — Tout validé ?",
