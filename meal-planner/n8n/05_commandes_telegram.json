{
  "name": "05 — Commandes Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000001",
      "name": "Telegram Trigger — Messages",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 400],
      "webhookId": "telegram-messages-webhook",
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst text = msg?.text || '';\nconst chatId = msg?.chat?.id;\nconst userId = msg?.from?.id;\n\n// Extract command (first word) and args (rest)\nconst parts = text.trim().split(' ');\nconst command = parts[0].toLowerCase().replace('@carter_meal_bot', '');\nconst args = parts.slice(1).join(' ').trim();\n\nreturn [{ json: { command, args, chatId, userId, rawText: text } }];"
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000002",
      "name": "Code — Parser commande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 400]
    },
    {
      "parameters": {
        "mode": "expression",
        "output": "={{ $json.command }}",
        "rules": {
          "rules": [
            { "value": "/planifier",    "renameOutput": true, "outputKey": "planifier"    },
            { "value": "/courses",      "renameOutput": true, "outputKey": "courses"      },
            { "value": "/ajouter",      "renameOutput": true, "outputKey": "ajouter"      },
            { "value": "/statut",       "renameOutput": true, "outputKey": "statut"       },
            { "value": "/aide",         "renameOutput": true, "outputKey": "aide"         },
            { "value": "/start",        "renameOutput": true, "outputKey": "aide"         }
          ]
        },
        "options": { "fallbackOutput": "none" }
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000003",
      "name": "Switch — Commande",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [520, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WEBHOOK_URL }}/webhook/planifier",
        "sendBody": true,
        "bodyType": "json",
        "body": { "chatId": "={{ $json.chatId }}", "source": "telegram_command" },
        "options": {}
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000004",
      "name": "HTTP — Trigger planifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 100]
    },
    {
      "parameters": {
        "chatId": "={{ $('Code — Parser commande').first().json.chatId }}",
        "text": "🔄 Planification en cours... Tu recevras les propositions dans quelques secondes.",
        "additionalFields": {}
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000005",
      "name": "Telegram — Ack planifier",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [780, 250],
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "={{ $env.NOTION_DB_HISTORIQUE }}",
          "mode": "id"
        },
        "filterType": "json",
        "filterJson": "={ \"or\": [{ \"property\": \"Statut\", \"select\": { \"equals\": \"Validé\" } }, { \"property\": \"Statut\", \"select\": { \"equals\": \"En attente\" } }] }",
        "returnAll": false,
        "limit": 1,
        "sort": { "sortValue": [{ "key": "Date_début", "order": "descending" }] }
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000006",
      "name": "Notion — Get liste actuelle",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [780, 450],
      "credentials": { "notionApi": { "id": "NOTION_CREDENTIAL_ID", "name": "Notion API" } }
    },
    {
      "parameters": {
        "jsCode": "const hist = $input.first().json;\nconst listRaw = hist.properties?.Liste_courses_finale?.rich_text?.[0]?.plain_text || null;\nconst semaine = hist.properties?.Semaine?.title?.[0]?.plain_text || 'cette semaine';\nconst statut = hist.properties?.Statut?.select?.name || 'En attente';\nconst chatId = $('Code — Parser commande').first().json.chatId;\n\nif (!listRaw) {\n  return [{ json: { msg: `📋 Pas encore de liste pour ${semaine}. Lance /planifier pour commencer.`, chatId } }];\n}\n\nconst list = JSON.parse(listRaw);\nconst emoji = {'Fruits & Légumes':'🥦','Viandes & Poissons':'🥩','Produits laitiers & Œufs':'🥛','Boulangerie':'🥖','Épicerie sèche':'🫙','Conserves & Sauces':'🥫','Surgelés':'🧊','Boissons':'💧','Hygiène & Maison':'🧴'};\n\nlet msg = `🛒 *Liste de courses — ${semaine}* (${statut})\\n\\n`;\nfor (const [cat, items] of Object.entries(list)) {\n  if (!items?.length) continue;\n  msg += `${emoji[cat] || '📦'} *${cat}*\\n`;\n  items.forEach(i => { msg += `• ${i.article} — ${i.quantite} ${i.unite}\\n`; });\n  msg += '\\n';\n}\n\nreturn [{ json: { msg, chatId } }];"
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000007",
      "name": "Code — Formater liste courses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 450]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.msg }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000008",
      "name": "Telegram — Envoyer liste",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1300, 450],
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    },
    {
      "parameters": {
        "jsCode": "// Append custom item to the current shopping list in Notion\nconst args = $('Code — Parser commande').first().json.args;\nconst chatId = $('Code — Parser commande').first().json.chatId;\nif (!args) {\n  return [{ json: { skip: true, msg: 'Usage: /ajouter <article> (ex: /ajouter Lait de coco)', chatId } }];\n}\nreturn [{ json: { article: args, chatId } }];"
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000009",
      "name": "Code — Préparer ajout",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 650]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "={{ $env.NOTION_DB_HISTORIQUE }}",
          "mode": "id"
        },
        "filterType": "json",
        "filterJson": "={ \"property\": \"Statut\", \"select\": { \"equals\": \"Validé\" } }",
        "returnAll": false,
        "limit": 1,
        "sort": { "sortValue": [{ "key": "Date_début", "order": "descending" }] }
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000010",
      "name": "Notion — Get historique pour ajout",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1040, 650],
      "credentials": { "notionApi": { "id": "NOTION_CREDENTIAL_ID", "name": "Notion API" } }
    },
    {
      "parameters": {
        "jsCode": "const hist = $input.first().json;\nconst article = $('Code — Préparer ajout').first().json.article;\nconst listRaw = hist.properties?.Liste_courses_finale?.rich_text?.[0]?.plain_text || '{}';\nconst list = JSON.parse(listRaw);\n\n// Append to 'Épicerie sèche' as catch-all\nif (!list['Ajouts manuels']) list['Ajouts manuels'] = [];\nlist['Ajouts manuels'].push({ article, quantite: '1', unite: 'pc' });\n\nreturn [{ json: { updatedList: JSON.stringify(list), historiqueId: hist.id, article } }];"
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000011",
      "name": "Code — Mettre à jour liste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 650]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": "={{ $json.historiqueId }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Liste_courses_finale", "type": "richText", "textContent": "={{ $json.updatedList }}" }
          ]
        },
        "options": {}
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000012",
      "name": "Notion — Sauvegarder ajout",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1560, 650],
      "credentials": { "notionApi": { "id": "NOTION_CREDENTIAL_ID", "name": "Notion API" } }
    },
    {
      "parameters": {
        "chatId": "={{ $('Code — Parser commande').first().json.chatId }}",
        "text": "=✅ *{{ $('Code — Mettre à jour liste').first().json.article }}* ajouté à la liste de courses !",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000013",
      "name": "Telegram — Confirmer ajout",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1820, 650],
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    },
    {
      "parameters": {
        "chatId": "={{ $('Code — Parser commande').first().json.chatId }}",
        "text": "=🤖 *Carter Meal Planner*\n\nCommandes disponibles :\n\n/planifier — Proposer le menu de la semaine\n/courses — Afficher la liste de courses\n/ajouter <article> — Ajouter un article à la liste\n/statut — Statut de la semaine en cours\n/aide — Afficher ce message\n\n_Bébé-friendly • 0€ • Hors-ligne_",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000014",
      "name": "Telegram — Aide",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [780, 850],
      "credentials": { "telegramApi": { "id": "TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot API" } }
    }
  ],
  "connections": {
    "Telegram Trigger — Messages":  { "main": [[{ "node": "Code — Parser commande",        "type": "main", "index": 0 }]] },
    "Code — Parser commande":       { "main": [[{ "node": "Switch — Commande",             "type": "main", "index": 0 }]] },
    "Switch — Commande": {
      "main": [
        [{ "node": "HTTP — Trigger planifier",        "type": "main", "index": 0 },
         { "node": "Telegram — Ack planifier",        "type": "main", "index": 0 }],
        [{ "node": "Notion — Get liste actuelle",     "type": "main", "index": 0 }],
        [{ "node": "Code — Préparer ajout",           "type": "main", "index": 0 }],
        [{ "node": "Notion — Get liste actuelle",     "type": "main", "index": 0 }],
        [{ "node": "Telegram — Aide",                 "type": "main", "index": 0 }]
      ]
    },
    "Notion — Get liste actuelle":  { "main": [[{ "node": "Code — Formater liste courses",  "type": "main", "index": 0 }]] },
    "Code — Formater liste courses":{ "main": [[{ "node": "Telegram — Envoyer liste",       "type": "main", "index": 0 }]] },
    "Code — Préparer ajout":        { "main": [[{ "node": "Notion — Get historique pour ajout", "type": "main", "index": 0 }]] },
    "Notion — Get historique pour ajout": { "main": [[{ "node": "Code — Mettre à jour liste", "type": "main", "index": 0 }]] },
    "Code — Mettre à jour liste":   { "main": [[{ "node": "Notion — Sauvegarder ajout",     "type": "main", "index": 0 }]] },
    "Notion — Sauvegarder ajout":   { "main": [[{ "node": "Telegram — Confirmer ajout",     "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "05000000-0000-0000-0000-000000000005",
  "meta": { "templateCredsSetupCompleted": false },
  "id": "workflow-05-commandes",
  "tags": [{ "name": "meal-planner" }]
}
