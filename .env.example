# Carter — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env

# ─── Notion ──────────────────────────────────────────────────────────────────
# Obtenir sur notion.so/my-integrations → créer une intégration
NOTION_TOKEN=

# IDs des bases de données (visibles dans l'URL de chaque base Notion)
NOTION_DB_RECETTES=
NOTION_DB_GARDE_MANGER=
NOTION_DB_HISTORIQUE=

# ─── Gemini (Google AI Studio — gratuit) ─────────────────────────────────────
# Obtenir sur aistudio.google.com → Get API key (aucune CB requise)
GEMINI_API_KEY=

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=3000
