# ---------------------------------------------------------------------------
# Carter — configuration serveur
#
# Ce fichier est un modele. Copie-le en `.env` et remplis les valeurs.
# Le `.env` reel n'est JAMAIS commite (voir .gitignore).
#
# IMPORTANT : aucune de ces valeurs ne doit apparaitre dans le bundle frontend.
# Le navigateur appelle uniquement le backend Carter, jamais les API tierces.
# ---------------------------------------------------------------------------

# --- Serveur ---------------------------------------------------------------
# PORT et HOST ne servent qu'au serveur long-vivant (local, ou hebergement
# classique). Sur Vercel, la plateforme s'en charge.
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# --- Base de donnees -------------------------------------------------------
# Postgres. Sur Vercel, ajoute une base Neon au projet : la variable est
# injectee automatiquement, tu n'as rien a copier ici.
#
# Utilise l'URL POOLEE (elle contient `-pooler`). En serverless, chaque
# invocation peut ouvrir sa propre connexion : sans le pooler, la limite de
# connexions de la base est atteinte rapidement.
#
# Format : postgres://utilisateur:motdepasse@hote/base?sslmode=require
DATABASE_URL=

# Base utilisee par les tests d'integration. Laisser vide desactive ces tests
# (le reste de la suite tourne sans base). ATTENTION : ces tests effacent le
# schema public — ne jamais pointer sur ta vraie base.
# TEST_DATABASE_URL=postgres://carter@127.0.0.1:5433/carter_test

# --- Protection d'acces ----------------------------------------------------
# L'app est mono-utilisateur mais hebergee en ligne : elle DOIT etre protegee.
# Mot de passe unique demande a l'ouverture. Choisis une phrase longue.
# Genere un secret de session avec : openssl rand -hex 32
APP_PASSWORD=change-moi-par-une-phrase-longue
SESSION_SECRET=change-moi-openssl-rand-hex-32

# Duree de validite de la session, en jours.
SESSION_TTL_DAYS=30

# --- Intervals.icu ---------------------------------------------------------
# Cle API personnelle : Settings > Developer Settings sur intervals.icu.
# L'authentification est un basic auth avec le login litteral "API_KEY"
# et la cle en mot de passe.
# L'athlete id est visible dans l'URL de ton profil (format i123456).
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=

# Prefixe appose au nom de chaque evenement cree par l'app. Il sert a
# identifier sans ambiguite ce qui appartient a Carter : une suppression ne
# porte JAMAIS sur un evenement qui ne le porte pas.
# Ne le change pas apres une premiere synchro sans relire le README.
INTERVALS_EVENT_PREFIX=[PLAN]

# --- Synchronisation -------------------------------------------------------
# Nombre de semaines poussees vers le provider a partir d'aujourd'hui.
SYNC_WINDOW_WEEKS=6

# Types de seances synchronisees vers le calendrier, separes par des virgules.
# Valeurs possibles : FOOTING, SORTIE_LONGUE, COTES, SEUIL, RENFO, VELO
# Par defaut : course + renforcement, sans le velo.
SYNC_TYPES=FOOTING,SORTIE_LONGUE,COTES,SEUIL,RENFO

# Delai minimal entre deux requetes vers un provider, en millisecondes.
SYNC_RATE_LIMIT_MS=350

# Temps maximal accorde a une application de synchro, en millisecondes.
# Doit rester sous le `maxDuration` de la fonction Vercel (60 s dans
# vercel.json), avec de la marge pour renvoyer la reponse. Au-dela du budget,
# le moteur s'arrete proprement et annonce ce qui reste a faire.
SYNC_BUDGET_MS=45000

# --- Garmin, API Training officielle (desactivee) --------------------------
# Reservee aux partenaires du Garmin Connect Developer Program. Ces deux
# variables attendent des cles partenaire, PAS ton identifiant personnel.
GARMIN_ENABLED=false
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# --- Garmin, connexion directe (non officielle) ----------------------------
# Se connecte a ton compte Garmin Connect par le meme mecanisme que
# l'application mobile. LECTURE SEULE : activites, sommeil, HRV, FC de repos,
# poids, Body Battery. L'ecriture du plan reste sur Intervals.icu.
#
# A savoir avant d'activer :
#  - contraire aux conditions d'utilisation de Garmin ;
#  - casse quand Garmin modifie son SSO, sans preavis ;
#  - souvent bloque depuis une IP de datacenter (Vercel, AWS) par la
#    protection anti-bot, la ou la meme requete passe depuis chez toi.
#
# Tes identifiants ne se mettent PAS ici : ils se saisissent dans l'app,
# servent une fois a obtenir des jetons, et ne sont jamais conserves. Seuls
# les jetons sont stockes, chiffres avec une clef derivee de SESSION_SECRET
# (qui devient donc obligatoire).
GARMIN_DIRECT_ENABLED=false
