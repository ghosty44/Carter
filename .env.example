# ---------------------------------------------------------------------------
# Carter — configuration serveur
#
# Copie ce fichier en `.env` et remplis les valeurs. Le `.env` reel n'est
# JAMAIS commite (voir .gitignore).
#
# Aucune de ces valeurs n'apparait dans le bundle frontend : le navigateur
# appelle uniquement le backend Carter, jamais Garmin directement.
# ---------------------------------------------------------------------------

# --- Serveur ---------------------------------------------------------------
# PORT et HOST ne servent qu'au serveur long-vivant (local ou hebergement
# classique). Sur Vercel, la plateforme s'en charge.
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# --- Base de donnees -------------------------------------------------------
# Postgres. Sur Vercel : Storage > Create Database > Neon, la variable est
# injectee automatiquement.
#
# Utilise l'URL POOLEE (elle contient `-pooler`) : en serverless chaque
# invocation peut ouvrir sa propre connexion, et le pooler evite de saturer
# la limite de connexions de la base.
DATABASE_URL=

# Base des tests d'integration. Vide = tests ignores.
# ATTENTION : ces tests effacent le schema public. Jamais ta vraie base.
# TEST_DATABASE_URL=postgres://carter@127.0.0.1:5433/carter_test

# --- Protection d'acces ----------------------------------------------------
# L'app est mono-utilisateur mais accessible en ligne : elle DOIT etre
# protegee. En production, le serveur refuse de demarrer sans ces deux
# valeurs. Genere le secret avec : openssl rand -hex 32
APP_PASSWORD=change-moi-par-une-phrase-longue
SESSION_SECRET=change-moi-openssl-rand-hex-32

# Duree de validite de la session, en jours.
SESSION_TTL_DAYS=30

# --- Garmin ----------------------------------------------------------------
# Connexion au compte Garmin Connect, par le mecanisme de l'application
# mobile. LECTURE SEULE.
#
# A savoir : contraire aux CGU de Garmin, casse quand Garmin modifie son SSO,
# et parfois bloque depuis une IP de datacenter par la protection anti-bot.
#
# Tes identifiants ne se mettent PAS ici : ils se saisissent dans l'app,
# servent une fois a obtenir des jetons, et ne sont jamais conserves. Seuls
# les jetons sont stockes, chiffres avec une clef derivee de SESSION_SECRET
# (qui devient donc obligatoire).
GARMIN_ENABLED=false

# Nombre d'activites remontees a chaque recuperation.
GARMIN_LIMITE_ACTIVITES=100

# Nombre de jours de forme remontes a chaque recuperation. Chaque jour coute
# trois requetes a Garmin : au-dela de 30 jours, la recuperation devient
# longue et risque de depasser le temps imparti a une fonction serverless.
GARMIN_JOURS_WELLNESS=30
