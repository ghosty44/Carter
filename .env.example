# Carter Meal Planner — Variables d'environnement
# Copier ce fichier, remplir les valeurs, et les stocker dans Railway → Variables
# NE JAMAIS committer le fichier avec les vraies valeurs

# ─── Telegram ───────────────────────────────────────────────────────────────
# Obtenir via @BotFather
TELEGRAM_BOT_TOKEN=

# Obtenir via @userinfobot (votre chat_id après avoir démarré le bot)
TELEGRAM_CHAT_ID_PRINCIPAL=

# Chat ID de la conjointe/conjoint (optionnel, même procédure)
TELEGRAM_CHAT_ID_CONJOINT=

# ─── Notion ─────────────────────────────────────────────────────────────────
# Obtenir sur notion.so/my-integrations
NOTION_TOKEN=

# IDs des bases de données (dans l'URL de chaque base Notion)
NOTION_DB_RECETTES=
NOTION_DB_GARDE_MANGER=
NOTION_DB_HISTORIQUE=

# ─── Gemini (Google AI Studio — gratuit) ────────────────────────────────────
# Obtenir sur aistudio.google.com → Get API key (aucune CB requise)
GEMINI_API_KEY=

# ─── Intermarché Drive API (optionnel) ──────────────────────────────────────
# Obtenir après inscription sur developers.intermarche.com
INTERMARCHE_CLIENT_ID=
INTERMARCHE_CLIENT_SECRET=
# Numéro de votre magasin Intermarché
INTERMARCHE_STORE_ID=

# ─── n8n (configuré automatiquement par Railway) ────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
# Généré automatiquement par Railway (domaine public)
WEBHOOK_URL=https://YOUR_RAILWAY_DOMAIN.railway.app
